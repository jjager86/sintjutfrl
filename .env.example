FACEBOOK_RSS_URL=

# Publieke HTTPS-URL uit Coolify, zonder slash aan het einde
PUBLIC_URL=https://sintjut.example.nl

# MariaDB
MARIADB_ROOT_PASSWORD=vervang-door-een-lang-wachtwoord
DB_DATABASE=sintjut
DB_USER=sintjut
DB_PASSWORD=vervang-door-een-ander-lang-wachtwoord

# Telegram-beheerders
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=
# Komma-gescheiden numerieke Telegram user IDs; alleen deze accounts mogen beslissen
TELEGRAM_ADMIN_USER_IDS=

# Cloudflare Turnstile (optioneel; secret invullen schakelt handhaving in)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=sintjut.example.nl

# Microsoft 365 / Graph
GRAPH_SYNC_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=agenda@sintjut.frl
# Formaat: ruimte-slug=calendar-id,ruimte-slug=calendar-id
GRAPH_CALENDAR_IDS=doarpsfinne=,vergaderruimte=,grote-zaal=
GRAPH_WEBHOOK_CLIENT_STATE=
