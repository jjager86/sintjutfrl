---
import Logo from '../components/Logo.astro';
import '../styles/shared.css';
const {title,intro,eyebrow='ONS DORPSPLEIN',heroImage='/media/hero-sintjohannesga.webp',heroAlt='Sfeerbeeld van het Friese landschap rond Sint Jut'}=Astro.props;
---
<!doctype html><html lang="nl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>{title} · Sint Jut</title><meta name="description" content={intro}/><link rel="icon" href="/favicon.svg"/></head><body><a class="skip" href="#main">Direct naar inhoud</a><div class="topline"><div>Sint Jut. Eén dorpsgemeenschap.</div><span>Het digitale dorpsplein</span></div><header><Logo /><nav aria-label="Hoofdnavigatie"><a href="/#agenda">Dorpsagenda</a><a href="/verenigingen/">Verenigingen</a><a href="/dorpsfilms/">Dorpsfilms</a><a href="/woningbouw/">Woningbouw</a><a class="nav-button" href="/lid-worden/">Word lid →</a></nav></header><main id="main"><section class="intro content-hero"><img class="hero-image" src={heroImage} alt={heroAlt}/><div class="hero-shade"></div><div class="content-hero-copy"><a class="back" href="/">← Naar het dorpsplein</a><div class="eyebrow">{eyebrow}</div><h1>{title}</h1><p class="lead">{intro}</p></div></section><slot/></main><footer><Logo /><p>Sint Jut · één dorpsgemeenschap</p><a href="/lid-worden/">Word lid van een vereniging →</a></footer></body></html>
