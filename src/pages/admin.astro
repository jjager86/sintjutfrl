---
import Logo from '../components/Logo.astro';
import '../styles/shared.css';
import '../styles/admin.css';
---
<!doctype html>
<html lang="nl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><title>Agendabeheer · Sint Jut</title><meta name="description" content="Beheer de dorpsagenda van Sint Jut."/><link rel="icon" href="/favicon.svg"/></head>
<body class="admin-body">
  <a class="skip" href="#admin-main">Direct naar beheer</a>
  <header class="admin-header"><Logo/><div class="admin-heading"><span>BEHEER</span><strong>Dorpsagenda</strong></div><a href="/">Naar de website →</a></header>
  <main id="admin-main" class="admin-main">
    <section id="admin-login" class="admin-login"><div class="admin-login-card"><span class="admin-kicker">SINT JUT BEHEER</span>
      <div id="login-panel"><h1>Welkom terug.</h1><p>Meld je aan met je eigen beheeraccount.</p><form id="login-form"><label>Gebruikersnaam<input name="username" autocomplete="username" required/></label><label>Wachtwoord<input name="password" type="password" autocomplete="current-password" required/></label><button type="submit">Aanmelden →</button></form></div>
      <div id="bootstrap-panel" hidden><h1>Eerste beheerder.</h1><p>Maak eenmalig het hoofdaccount aan met de installatiesleutel uit Coolify.</p><form id="bootstrap-form"><label>Installatiesleutel<input name="bootstrap_token" type="password" autocomplete="off" required/></label><label>Gebruikersnaam<input name="username" autocomplete="username" minlength="3" required/></label><label>Naam<input name="display_name" autocomplete="name" required/></label><label>Wachtwoord<input name="password" type="password" autocomplete="new-password" minlength="12" required/><small>Minimaal 12 tekens.</small></label><button type="submit">Hoofdbeheerder aanmaken →</button></form></div>
      <p id="login-result" role="status"></p>
    </div></section>

    <section id="admin-dashboard" class="admin-dashboard" hidden>
      <div class="admin-title"><div><span class="admin-kicker">AGENDA</span><h1>Activiteiten beheren</h1><p id="welcome-copy">Beheer de gezamenlijke dorpsagenda.</p></div><div class="admin-title-actions"><button id="new-event" type="button">＋ Activiteit</button><button id="logout" class="secondary" type="button">Afmelden</button></div></div>
      <nav class="admin-tabs" aria-label="Beheeronderdelen"><button class="active" data-panel="agenda-panel" type="button">Agenda</button><button id="requests-tab" data-panel="requests-panel" type="button" hidden>Aanvragen</button><button id="memberships-tab" data-panel="memberships-panel" type="button" hidden>Lid worden</button><button id="users-tab" data-panel="users-panel" type="button" hidden>Gebruikers</button></nav>
      <section id="agenda-panel" class="admin-panel"><div class="admin-toolbar"><label>Vanaf<input id="admin-from" type="date"/></label><label>Tot en met<input id="admin-to" type="date"/></label><button id="refresh-events" type="button">Vernieuwen</button></div><div class="admin-summary"><article><span>Activiteiten</span><strong id="event-total">—</strong></article><article><span>Te wijzigen</span><strong id="editable-total">—</strong></article><article><span>Gekoppeld / alleen lezen</span><strong id="linked-total">—</strong></article></div><p id="admin-status" class="admin-status" role="status">Agenda laden…</p><div id="admin-events" class="admin-events" aria-live="polite"></div></section>
      <section id="requests-panel" class="admin-panel" hidden><div class="users-heading"><div><h2>Evenementaanvragen</h2><p>Controleer aanmeldingen van inwoners voordat ze in de openbare kalender verschijnen.</p></div><button id="load-municipal" type="button">Importeren uit De Fryske Marren</button></div><p id="requests-status" class="admin-status" role="status"></p><div id="event-requests" class="admin-users"></div><section id="municipal-panel" class="municipal-panel" hidden><div class="municipal-heading"><div><span class="admin-kicker">EXTERNE BRON</span><h2>Evenementen De Fryske Marren</h2><p>Kies zelf welke gemeentelijke evenementen ook in de Sint Jut-kalender verschijnen.</p></div><a href="https://www.defryskemarren.nl/direct-regelen/vergunningen-toestemming/evenementenkalender/">Bekijk bron →</a></div><p id="municipal-status" class="admin-status" role="status"></p><div id="municipal-events" class="admin-users"></div></section></section>
      <section id="memberships-panel" class="admin-panel" hidden><div class="users-heading"><div><h2>Lidmaatschapsaanvragen</h2><p>Deze gegevens bevatten versleutelde bankinformatie. Behandel ze vertrouwelijk.</p></div></div><p id="memberships-status" class="admin-status" role="status"></p><div id="admin-memberships" class="admin-users"></div></section>
      <section id="users-panel" class="admin-panel" hidden><div class="users-heading"><div><h2>Gebruikers en ruimterechten</h2><p>Geef iedere beheerder alleen toegang tot de ruimtes waarvoor die verantwoordelijk is.</p></div><button id="new-user" type="button">＋ Gebruiker</button></div><p id="users-status" class="admin-status" role="status"></p><div id="admin-users" class="admin-users"></div></section>
    </section>
  </main>

  <dialog id="event-dialog" class="admin-dialog"><button class="admin-dialog-close" type="button" aria-label="Sluiten">×</button><span class="admin-kicker">ACTIVITEIT</span><h2 id="event-dialog-title">Activiteit toevoegen</h2><form id="event-form"><div class="admin-form-grid"><label class="wide">Titel<input name="title" maxlength="180" required/></label><label>Ruimte<select name="resource_id" required></select></label><label>Locatievermelding<input name="location" maxlength="255" placeholder="Optioneel"/></label><label>Begint<input name="starts_at" type="datetime-local" required/></label><label>Eindigt<input name="ends_at" type="datetime-local" required/></label><label class="wide">Openbare omschrijving<textarea name="public_description" maxlength="2000" rows="4"></textarea></label><label class="wide">Logo-URL<input name="logo_url" type="url" maxlength="500" placeholder="https://…"/><small>Optioneel. Zonder logo gebruikt de kaart het locatie- of Sint Jut-logo.</small></label></div><p id="event-result" class="admin-form-result" role="status"></p><div class="admin-dialog-actions"><button id="delete-event" class="danger" type="button" hidden>Verwijderen</button><span></span><button class="secondary event-cancel" type="button">Annuleren</button><button id="save-event" type="submit">Opslaan →</button></div></form></dialog>

  <dialog id="user-dialog" class="admin-dialog user-dialog"><button class="user-dialog-close admin-dialog-close" type="button" aria-label="Sluiten">×</button><span class="admin-kicker">GEBRUIKER</span><h2 id="user-dialog-title">Gebruiker toevoegen</h2><form id="user-form"><div class="admin-form-grid"><label>Naam<input name="display_name" maxlength="160" required/></label><label>Gebruikersnaam<input name="username" maxlength="80" pattern="[a-zA-Z0-9._-]{3,80}" required/></label><label class="wide">Wachtwoord<input name="password" type="password" minlength="12" autocomplete="new-password"/><small id="password-help">Minimaal 12 tekens.</small></label></div><div class="user-switches"><label><input name="is_active" type="checkbox" checked/> Account actief</label><label><input name="is_super_admin" type="checkbox"/> Hoofdbeheerder (toegang tot alles)</label><label><input name="can_manage_memberships" type="checkbox"/> Lidmaatschappen beheren</label></div><fieldset id="permission-fieldset"><legend>Rechten per ruimte</legend><p>Bekijken bepaalt welke agenda zichtbaar is. Toevoegen, wijzigen en verwijderen kunnen apart worden toegekend.</p><div id="permission-list" class="permission-list"></div></fieldset><p id="user-result" class="admin-form-result" role="status"></p><div class="admin-dialog-actions user-actions"><span></span><span></span><button class="secondary user-cancel" type="button">Annuleren</button><button id="save-user" type="submit">Opslaan →</button></div></form></dialog>

  <script>
    const storageKey='sintjut-admin-session'; const $=(selector:string)=>document.querySelector(selector) as HTMLElement;
    const login=$('#admin-login'),dashboard=$('#admin-dashboard'),loginForm=$('#login-form') as HTMLFormElement,bootstrapForm=$('#bootstrap-form') as HTMLFormElement,eventForm=$('#event-form') as HTMLFormElement,eventDialog=$('#event-dialog') as HTMLDialogElement,userForm=$('#user-form') as HTMLFormElement,userDialog=$('#user-dialog') as HTMLDialogElement;
    let adminToken=sessionStorage.getItem(storageKey)||'',currentUser:any=null,resources:any[]=[],events:any[]=[],users:any[]=[],eventRequests:any[]=[],municipalItems:any[]=[],memberships:any[]=[];
    const localDate=(date:Date)=>`${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`,localDateTime=(date:Date)=>`${localDate(date)}T${String(date.getHours()).padStart(2,'0')}:${String(date.getMinutes()).padStart(2,'0')}`;
    const from=$('#admin-from') as HTMLInputElement,to=$('#admin-to') as HTMLInputElement;from.value=localDate(new Date());const until=new Date();until.setDate(until.getDate()+180);to.value=localDate(until);
    async function request(path:string,options:RequestInit={},authenticated=true){const headers:any={'content-type':'application/json',...(options.headers||{})};if(authenticated&&adminToken)headers.authorization=`Bearer ${adminToken}`;const response=await fetch(path,{...options,headers,cache:'no-store'}),result=await response.json().catch(()=>({error:'Ongeldig antwoord van de server.'}));if(authenticated&&response.status===401){sessionStorage.removeItem(storageKey);adminToken='';showLogin();}if(!response.ok)throw new Error(result.error||'De aanvraag is mislukt.');return result;}
    function showLogin(){login.hidden=false;dashboard.hidden=true;currentUser=null;}
    async function showDashboard(user:any){currentUser=user;login.hidden=true;dashboard.hidden=false;$('#welcome-copy').textContent=`Ingelogd als ${user.display_name}. Je ziet alleen de onderdelen waarvoor je rechten hebt.`;($('#users-tab') as HTMLButtonElement).hidden=!user.is_super_admin;($('#memberships-tab') as HTMLButtonElement).hidden=!(user.is_super_admin||user.can_manage_memberships);await loadAll();}
    async function initialize(){if(adminToken){try{const session=await request('/api/v1/admin/session');return showDashboard(session.user);}catch{}}showLogin();try{const status=await request('/api/v1/admin/status',{},false);$('#login-panel').hidden=!status.configured;$('#bootstrap-panel').hidden=status.configured;if(!status.configured&&!status.bootstrap_available)$('#login-result').textContent='Stel eerst ADMIN_TOKEN in bij Coolify en start de website opnieuw.';}catch(error){$('#login-result').textContent=error instanceof Error?error.message:'Beheerstatus laden mislukt.';}}
    loginForm.addEventListener('submit',async event=>{event.preventDefault();$('#login-result').textContent='Aanmelden…';try{const data=Object.fromEntries(new FormData(loginForm)),result=await request('/api/v1/admin/login',{method:'POST',body:JSON.stringify(data)},false);adminToken=result.token;sessionStorage.setItem(storageKey,adminToken);$('#login-result').textContent='';await showDashboard(result.user);}catch(error){$('#login-result').textContent=error instanceof Error?error.message:'Aanmelden mislukt.';}});
    bootstrapForm.addEventListener('submit',async event=>{event.preventDefault();$('#login-result').textContent='Hoofdbeheerder aanmaken…';const data=Object.fromEntries(new FormData(bootstrapForm));try{await request('/api/v1/admin/bootstrap',{method:'POST',body:JSON.stringify(data)},false);const result=await request('/api/v1/admin/login',{method:'POST',body:JSON.stringify({username:data.username,password:data.password})},false);adminToken=result.token;sessionStorage.setItem(storageKey,adminToken);await showDashboard(result.user);}catch(error){$('#login-result').textContent=error instanceof Error?error.message:'Account aanmaken mislukt.';}});
    $('#logout').addEventListener('click',async()=>{try{await request('/api/v1/admin/logout',{method:'POST'});}catch{}sessionStorage.removeItem(storageKey);adminToken='';showLogin();location.reload();});
    document.querySelectorAll<HTMLButtonElement>('.admin-tabs button').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll<HTMLButtonElement>('.admin-tabs button').forEach(item=>item.classList.toggle('active',item===button));document.querySelectorAll<HTMLElement>('.admin-panel').forEach(panel=>panel.hidden=panel.id!==button.dataset.panel);if(button.dataset.panel==='users-panel')loadUsers();if(button.dataset.panel==='requests-panel')loadEventRequests();if(button.dataset.panel==='memberships-panel')loadMemberships();}));
    async function loadAll(){try{$('#admin-status').textContent='Agenda laden…';const rangeStart=new Date(from.value+'T00:00:00').toISOString(),rangeEnd=new Date(to.value+'T23:59:59').toISOString(),[resourceData,eventData]=await Promise.all([request('/api/v1/admin/resources'),request(`/api/v1/admin/events?from=${encodeURIComponent(rangeStart)}&to=${encodeURIComponent(rangeEnd)}`)]);resources=resourceData.resources;events=eventData.events;renderEvents();($('#new-event') as HTMLButtonElement).hidden=!resources.some(resource=>resource.permissions.can_create);($('#requests-tab') as HTMLButtonElement).hidden=!resources.some(resource=>resource.slug==='evenementenkalender'&&resource.permissions.can_view);$('#admin-status').textContent=events.length?`Bijgewerkt om ${new Intl.DateTimeFormat('nl-NL',{timeStyle:'short'}).format(new Date())}.`:'Er staan geen activiteiten in deze periode.';}catch(error){$('#admin-status').textContent=error instanceof Error?error.message:'Agenda laden mislukt.';}}
    function renderEvents(){$('#event-total').textContent=String(events.length);$('#editable-total').textContent=String(events.filter(item=>item.editable).length);$('#linked-total').textContent=String(events.filter(item=>!item.editable).length);const container=$('#admin-events');container.replaceChildren();for(const item of events){const article=document.createElement('article');article.className='admin-event';const date=document.createElement('div');date.className='admin-event-date';const start=new Date(item.starts_at),day=document.createElement('b'),month=document.createElement('span');day.textContent=start.toLocaleDateString('nl-NL',{day:'2-digit',timeZone:'Europe/Amsterdam'});month.textContent=start.toLocaleDateString('nl-NL',{month:'short',timeZone:'Europe/Amsterdam'}).replace('.','');date.append(day,month);const copy=document.createElement('div');copy.className='admin-event-copy';const meta=document.createElement('div');meta.className='admin-event-meta';const source=document.createElement('span'),room=document.createElement('span');source.className=item.source==='website'?'manual':'linked';source.textContent=item.source==='municipality'?'De Fryske Marren':item.source==='website'?'Handmatig':'Outlook';room.textContent=item.resource_name;meta.append(source,room);const title=document.createElement('h2'),details=document.createElement('p');title.textContent=item.title;const format=new Intl.DateTimeFormat('nl-NL',{weekday:'short',hour:'2-digit',minute:'2-digit',timeZone:'Europe/Amsterdam'});details.textContent=`${format.format(start)} – ${new Intl.DateTimeFormat('nl-NL',{hour:'2-digit',minute:'2-digit',timeZone:'Europe/Amsterdam'}).format(new Date(item.ends_at))} · ${item.location||item.resource_location||item.resource_name}`;copy.append(meta,title,details);article.append(date,copy);if(item.editable||item.deletable){const button=document.createElement('button');button.type='button';button.textContent=item.editable?'Wijzigen':'Bekijken';button.addEventListener('click',()=>openEvent(item));article.append(button);}else{const note=document.createElement('small');note.textContent=item.source==='microsoft365'?'Beheer in Outlook':'Alleen lezen';article.append(note);}container.append(article);}}
    function populateEventResources(item:any=null){const select=eventForm.elements.namedItem('resource_id') as HTMLSelectElement,allowed=resources.filter(resource=>resource.permissions.can_create||resource.id===item?.resource_id);select.replaceChildren(...allowed.map(resource=>{const option=document.createElement('option');option.value=resource.id;option.textContent=resource.name;return option;}));}
    function openEvent(item:any=null){eventForm.reset();eventForm.dataset.id=item?.id||'';populateEventResources(item);$('#event-dialog-title').textContent=item?(item.editable?'Activiteit wijzigen':'Activiteit bekijken'):'Activiteit toevoegen';($('#delete-event') as HTMLButtonElement).hidden=!item?.deletable;($('#save-event') as HTMLButtonElement).hidden=Boolean(item&&!item.editable);$('#event-result').textContent='';eventForm.querySelectorAll<HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement>('input,textarea,select').forEach(field=>field.disabled=Boolean(item&&!item.editable));if(item){for(const name of ['title','resource_id','location','public_description','logo_url']){const field=eventForm.elements.namedItem(name) as HTMLInputElement|HTMLTextAreaElement|HTMLSelectElement;field.value=item[name]||'';}(eventForm.elements.namedItem('starts_at') as HTMLInputElement).value=localDateTime(new Date(item.starts_at));(eventForm.elements.namedItem('ends_at') as HTMLInputElement).value=localDateTime(new Date(item.ends_at));}else{const start=new Date();start.setMinutes(0,0,0);start.setHours(start.getHours()+1);const end=new Date(start);end.setHours(end.getHours()+2);(eventForm.elements.namedItem('starts_at') as HTMLInputElement).value=localDateTime(start);(eventForm.elements.namedItem('ends_at') as HTMLInputElement).value=localDateTime(end);}eventDialog.showModal();}
    $('#new-event').addEventListener('click',()=>openEvent());$('#refresh-events').addEventListener('click',loadAll);from.addEventListener('change',loadAll);to.addEventListener('change',loadAll);eventDialog.querySelector('.admin-dialog-close')?.addEventListener('click',()=>eventDialog.close());$('.event-cancel').addEventListener('click',()=>eventDialog.close());
    eventForm.addEventListener('submit',async event=>{event.preventDefault();const save=$('#save-event') as HTMLButtonElement;save.disabled=true;$('#event-result').textContent='Opslaan…';const data:any=Object.fromEntries(new FormData(eventForm));data.starts_at=new Date(String(data.starts_at)).toISOString();data.ends_at=new Date(String(data.ends_at)).toISOString();const id=eventForm.dataset.id;try{await request(id?`/api/v1/admin/events/${id}`:'/api/v1/admin/events',{method:id?'PUT':'POST',body:JSON.stringify(data)});eventDialog.close();await loadAll();}catch(error){$('#event-result').textContent=error instanceof Error?error.message:'Opslaan mislukt.';}finally{save.disabled=false;}});
    $('#delete-event').addEventListener('click',async()=>{const id=eventForm.dataset.id;if(!id||!confirm('Deze activiteit uit de agenda verwijderen?'))return;const button=$('#delete-event') as HTMLButtonElement;button.disabled=true;try{await request(`/api/v1/admin/events/${id}`,{method:'DELETE'});eventDialog.close();await loadAll();}catch(error){$('#event-result').textContent=error instanceof Error?error.message:'Verwijderen mislukt.';}finally{button.disabled=false;}});
    async function loadEventRequests(){try{$('#requests-status').textContent='Aanvragen laden…';const result=await request('/api/v1/admin/event-requests');eventRequests=result.requests;renderEventRequests();const pending=eventRequests.filter(item=>item.status==='pending').length;$('#requests-status').textContent=pending?`${pending} ${pending===1?'aanvraag wacht':'aanvragen wachten'} op beoordeling.`:'Er zijn geen openstaande aanvragen.';}catch(error){$('#requests-status').textContent=error instanceof Error?error.message:'Aanvragen laden mislukt.';}}
    function renderEventRequests(){const container=$('#event-requests');container.replaceChildren();for(const item of eventRequests){const article=document.createElement('article');article.className='admin-user event-request';const copy=document.createElement('div'),title=document.createElement('h3'),meta=document.createElement('p'),contact=document.createElement('small');title.textContent=item.title;const start=new Date(item.starts_at);meta.textContent=`${start.toLocaleDateString('nl-NL',{dateStyle:'medium'})} om ${start.toLocaleTimeString('nl-NL',{hour:'2-digit',minute:'2-digit'})} · ${item.location}`;contact.textContent=`${item.organizer_name} · ${item.organizer_email}${item.organizer_phone?' · '+item.organizer_phone:''}`;copy.append(title,meta,contact);const actions=document.createElement('div');actions.className='request-actions';if(item.status==='pending'){for(const [action,label] of [['approve','Goedkeuren'],['reject','Afwijzen']]){const button=document.createElement('button');button.type='button';button.textContent=label;button.classList.toggle('reject',action==='reject');button.addEventListener('click',()=>reviewRequest(item.id,action));actions.append(button);}}else{const badge=document.createElement('span');badge.className=`request-status ${item.status}`;badge.textContent=item.status==='approved'?'Goedgekeurd':'Afgewezen';actions.append(badge);}article.append(copy,actions);container.append(article);}}
    async function reviewRequest(id:string,action:string){if(action==='reject'&&!confirm('Deze evenementaanvraag afwijzen?'))return;try{await request(`/api/v1/admin/event-requests/${id}/${action}`,{method:'POST'});await Promise.all([loadEventRequests(),loadAll()]);}catch(error){$('#requests-status').textContent=error instanceof Error?error.message:'Beoordelen mislukt.';}}
    async function loadMunicipal(){const panel=$('#municipal-panel');panel.hidden=false;$('#municipal-status').textContent='Gemeentelijke kalender ophalen…';try{const result=await request('/api/v1/admin/municipal-events');municipalItems=result.events;renderMunicipal();$('#municipal-status').textContent=municipalItems.length?`${municipalItems.length} evenementen gevonden. Reeds toegevoegde evenementen zijn gemarkeerd.`:'Er zijn geen evenementen in de bron gevonden.';panel.scrollIntoView({behavior:'smooth',block:'start'});}catch(error){$('#municipal-status').textContent=error instanceof Error?error.message:'Gemeentelijke kalender ophalen mislukt.';}}
    function renderMunicipal(){const container=$('#municipal-events');container.replaceChildren();for(const item of municipalItems){const article=document.createElement('article');article.className='admin-user event-request';const copy=document.createElement('div'),title=document.createElement('h3'),meta=document.createElement('p');title.textContent=item.title;const start=new Date(item.starts_at),end=new Date(item.ends_at);meta.textContent=`${start.toLocaleDateString('nl-NL',{dateStyle:'medium'})}${start.toDateString()!==end.toDateString()?' – '+end.toLocaleDateString('nl-NL',{dateStyle:'medium'}):''} · ${item.location}`;copy.append(title,meta);const button=document.createElement('button');button.type='button';button.textContent=item.imported?'Al toegevoegd':'Toevoegen';button.disabled=item.imported;button.addEventListener('click',()=>importMunicipal(item.external_id,button));article.append(copy,button);container.append(article);}}
    async function importMunicipal(externalId:string,button:HTMLButtonElement){button.disabled=true;button.textContent='Toevoegen…';try{await request('/api/v1/admin/municipal-events/import',{method:'POST',body:JSON.stringify({external_id:externalId})});await Promise.all([loadMunicipal(),loadAll()]);}catch(error){button.disabled=false;button.textContent='Opnieuw proberen';$('#municipal-status').textContent=error instanceof Error?error.message:'Importeren mislukt.';}}
    $('#load-municipal').addEventListener('click',loadMunicipal);
    async function loadMemberships(){try{$('#memberships-status').textContent='Lidmaatschappen laden…';const result=await request('/api/v1/admin/memberships');memberships=result.memberships;renderMemberships();const pending=memberships.filter(item=>item.status==='pending').length;$('#memberships-status').textContent=pending?`${pending} ${pending===1?'aanmelding wacht':'aanmeldingen wachten'} op verwerking.`:'Er zijn geen openstaande lidmaatschapsaanvragen.';}catch(error){$('#memberships-status').textContent=error instanceof Error?error.message:'Lidmaatschappen laden mislukt.';}}
    function renderMemberships(){const container=$('#admin-memberships');container.replaceChildren();for(const item of memberships){const article=document.createElement('article');article.className='admin-user membership-request';const copy=document.createElement('div'),title=document.createElement('h3'),associations=document.createElement('p'),address=document.createElement('p'),bank=document.createElement('p'),note=document.createElement('small');title.textContent=`${item.first_name} ${item.last_name}`;associations.textContent=item.associations.join(' · ');address.textContent=`${item.street} ${item.house_number} · ${item.email}`;bank.textContent=`IBAN ${item.iban} · t.n.v. ${item.account_name}`;bank.className='membership-bank';note.textContent=item.note||`Referentie ${item.reference}`;copy.append(title,associations,address,bank,note);const actions=document.createElement('div');actions.className='request-actions';if(item.status==='pending'){for(const [status,label] of [['processed','Verwerkt'],['rejected','Afwijzen']]){const button=document.createElement('button');button.type='button';button.textContent=label;button.classList.toggle('reject',status==='rejected');button.addEventListener('click',()=>reviewMembership(item.id,status));actions.append(button);}}else{const badge=document.createElement('span');badge.className=`request-status ${item.status==='processed'?'approved':'rejected'}`;badge.textContent=item.status==='processed'?'Verwerkt':'Afgewezen';actions.append(badge);}article.append(copy,actions);container.append(article);}}
    async function reviewMembership(id:string,status:string){if(!confirm(status==='processed'?'Markeren als verwerkt?':'Deze lidmaatschapsaanvraag afwijzen?'))return;try{await request(`/api/v1/admin/memberships/${id}`,{method:'PUT',body:JSON.stringify({status})});await loadMemberships();}catch(error){$('#memberships-status').textContent=error instanceof Error?error.message:'Verwerken mislukt.';}}
    async function loadUsers(){if(!currentUser?.is_super_admin)return;try{$('#users-status').textContent='Gebruikers laden…';const result=await request('/api/v1/admin/users');users=result.users;renderUsers();$('#users-status').textContent=`${users.length} ${users.length===1?'gebruiker':'gebruikers'}.`;}catch(error){$('#users-status').textContent=error instanceof Error?error.message:'Gebruikers laden mislukt.';}}
    function renderUsers(){const container=$('#admin-users');container.replaceChildren();for(const user of users){const article=document.createElement('article');article.className='admin-user';const copy=document.createElement('div'),title=document.createElement('h3'),meta=document.createElement('p');title.textContent=user.display_name;meta.textContent=`${user.username} · ${user.is_super_admin?'Hoofdbeheerder':`${user.permissions.length} ${user.permissions.length===1?'ruimte':'ruimtes'}`} · ${user.is_active?'Actief':'Uitgeschakeld'}`;copy.append(title,meta);const button=document.createElement('button');button.type='button';button.textContent='Beheren';button.addEventListener('click',()=>openUser(user));article.append(copy,button);container.append(article);}}
    function renderPermissionRows(user:any=null){const container=$('#permission-list');container.replaceChildren();for(const resource of resources){const permission=user?.permissions?.find((item:any)=>item.resource_id===resource.id)||{},row=document.createElement('div');row.className='permission-row';row.dataset.resourceId=resource.id;const name=document.createElement('strong');name.textContent=resource.name;row.append(name);for(const [key,label] of [['can_view','Bekijken'],['can_create','Toevoegen'],['can_edit','Wijzigen'],['can_delete','Verwijderen']]){const field=document.createElement('label'),input=document.createElement('input');input.type='checkbox';input.dataset.permission=key;input.checked=Boolean(permission[key]);field.append(input,document.createTextNode(label));row.append(field);}container.append(row);}}
    function togglePermissions(){const superAdmin=(userForm.elements.namedItem('is_super_admin') as HTMLInputElement).checked;($('#permission-fieldset') as HTMLFieldSetElement).disabled=superAdmin;$('#permission-fieldset').classList.toggle('disabled',superAdmin);}
    function openUser(user:any=null){userForm.reset();userForm.dataset.id=user?.id||'';$('#user-dialog-title').textContent=user?'Gebruiker wijzigen':'Gebruiker toevoegen';(userForm.elements.namedItem('display_name') as HTMLInputElement).value=user?.display_name||'';(userForm.elements.namedItem('username') as HTMLInputElement).value=user?.username||'';(userForm.elements.namedItem('is_active') as HTMLInputElement).checked=user?user.is_active:true;(userForm.elements.namedItem('is_super_admin') as HTMLInputElement).checked=Boolean(user?.is_super_admin);(userForm.elements.namedItem('can_manage_memberships') as HTMLInputElement).checked=Boolean(user?.can_manage_memberships);(userForm.elements.namedItem('password') as HTMLInputElement).required=!user;$('#password-help').textContent=user?'Laat leeg om het bestaande wachtwoord te behouden.':'Minimaal 12 tekens.';$('#user-result').textContent='';renderPermissionRows(user);togglePermissions();userDialog.showModal();}
    $('#new-user').addEventListener('click',()=>openUser());(userForm.elements.namedItem('is_super_admin') as HTMLInputElement).addEventListener('change',togglePermissions);$('.user-dialog-close').addEventListener('click',()=>userDialog.close());$('.user-cancel').addEventListener('click',()=>userDialog.close());
    userForm.addEventListener('submit',async event=>{event.preventDefault();const save=$('#save-user') as HTMLButtonElement;save.disabled=true;$('#user-result').textContent='Opslaan…';const form=Object.fromEntries(new FormData(userForm)),data:any={username:form.username,display_name:form.display_name,password:form.password||undefined,is_active:Boolean(form.is_active),is_super_admin:Boolean(form.is_super_admin),can_manage_memberships:Boolean(form.can_manage_memberships),permissions:[...document.querySelectorAll<HTMLElement>('.permission-row')].map(row=>({resource_id:row.dataset.resourceId,...Object.fromEntries([...row.querySelectorAll<HTMLInputElement>('input[data-permission]')].map(input=>[input.dataset.permission,input.checked]))}))},id=userForm.dataset.id;try{await request(id?`/api/v1/admin/users/${id}`:'/api/v1/admin/users',{method:id?'PUT':'POST',body:JSON.stringify(data)});userDialog.close();await loadUsers();}catch(error){$('#user-result').textContent=error instanceof Error?error.message:'Opslaan mislukt.';}finally{save.disabled=false;}});
    initialize();
  </script>
</body></html>
