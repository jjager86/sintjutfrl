---
import Content from '../layouts/Content.astro';
const movies=[{id:'101V6zER4Ng',period:'1956–1963',part:1},{id:'ygsnixg_gc4',period:'1956–1963',part:2},{id:'fNME_T5T_Bg',period:'1970–1982',part:1},{id:'aQfZg8UyuBY',period:'1970–1982',part:2}];
---
<Content title="Ons dorp, in bewegend beeld." intro="Herbeleef de geschiedenis van Sint Jut in vier dorpsfilms uit het archief van Dorpengemeenschap Sintjohannesga e.o." eyebrow="HISTORISCHE DORPSFILMS" heroImage="/media/hero-rohel.webp" heroAlt="Sfeerbeeld van een open Friese polder met water en een dorpskern">
<section><label class="select-label">Kies een periode<select id="film-period"><option value="">Alle periodes</option><option>1956–1963</option><option>1970–1982</option></select></label><p class="note">De YouTube-speler wordt pas geladen wanneer je op ‘Film afspelen’ klikt.</p><div class="film-grid">{movies.map(m=><article data-period={m.period}><div class="film-screen" data-video={m.id}><span class="film-year">{m.period}</span><button class="action play" data-id={m.id} data-title={`Dorpsfilm ${m.period}, deel ${m.part}`}>▶ Film afspelen</button></div><div class="film-info"><span class="eyebrow">DEEL {m.part}</span><h2>Sint Jut {m.period}</h2><a class="text-link" href={`https://www.youtube.com/watch?v=${m.id}`}>Bekijk rechtstreeks op YouTube →</a></div></article>)}</div><p class="note">Bron: <a class="text-link" href="https://www.sintjut.frl/dorpsfilms/">het bestaande dorpsfilmarchief</a>.</p></section>
</Content>
<script>
document.querySelector('#film-period')?.addEventListener('change',e=>{const period=(e.target as HTMLSelectElement).value;document.querySelectorAll<HTMLElement>('[data-period]').forEach(el=>{el.hidden=!!period&&el.dataset.period!==period;if(el.hidden){const iframe=el.querySelector('iframe');if(iframe){iframe.remove();el.querySelector<HTMLElement>('.play')!.hidden=false;el.querySelector<HTMLElement>('.film-year')!.hidden=false}}});});
document.querySelectorAll<HTMLButtonElement>('.play').forEach(button=>button.addEventListener('click',()=>{const frame=document.createElement('iframe');frame.src=`https://www.youtube-nocookie.com/embed/${button.dataset.id}?autoplay=1`;frame.title=button.dataset.title!;frame.allow='autoplay; encrypted-media; picture-in-picture; fullscreen';frame.allowFullscreen=true;frame.referrerPolicy='strict-origin-when-cross-origin';button.hidden=true;button.parentElement!.querySelector<HTMLElement>('.film-year')!.hidden=true;button.parentElement!.append(frame);}));
</script>
