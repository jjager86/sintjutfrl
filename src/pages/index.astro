---
import Logo from '../components/Logo.astro';
import Facebook from '../components/Facebook.astro';
import Agenda from '../components/Agenda.astro';
import '../styles/shared.css';
const heroSlides=[
  {name:'Sintjohannesga',src:'/media/hero-sintjohannesga.webp',alt:'Sfeerbeeld van een Friese dorpsstraat aan de rand van groene weilanden'},
  {name:'Rotsterhaule',src:'/media/hero-rotsterhaule.webp',alt:'Sfeerbeeld van boerderijen, sloten en weilanden in het Friese landschap'},
  {name:'Rohel',src:'/media/hero-rohel.webp',alt:'Sfeerbeeld van een open polder met water en een kleine dorpskern'},
  {name:'Vierhuis',src:'/media/hero-vierhuis.webp',alt:'Sfeerbeeld van een kleine Friese buurtschap tussen de weilanden'}
];
---
<!doctype html><html lang="nl"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>Sint Jut · Ons digitale dorpsplein</title><meta name="description" content="Het digitale dorpsplein van Sint Jut. Ontdek activiteiten, verenigingen, initiatieven en dorpsruimtes."/><link rel="icon" href="/favicon.svg"/></head>
<body><a class="skip" href="#main">Direct naar inhoud</a><div class="topline"><div>Sint Jut. Eén dorpsgemeenschap.</div><span>Live dorpsagenda · ruimte aanvragen</span></div>
<header><Logo /><nav aria-label="Hoofdnavigatie"><a href="#agenda">Dorpsagenda</a><a href="/verenigingen/">Verenigingen</a><a href="/woningbouw/">Woningbouw</a><a href="#historie">Toen & nu</a><a class="nav-button" href="/lid-worden/">Word lid <span aria-hidden="true">→</span></a></nav></header>
<main id="main"><section class="intro" id="hero" data-slides={JSON.stringify(heroSlides)}><img class="hero-image" id="hero-image" src={heroSlides[0].src} alt={heroSlides[0].alt}/><div class="hero-shade"></div><div class="hero-copy"><div class="eyebrow">HET DIGITALE DORPSPLEIN</div><h1>Alles wat leeft<br/>in <em>Sint Jut.</em></h1><p>Eén plek om te zien wat er in onze dorpskern speelt<br/>en waar je kunt aanhaken.</p><div class="hero-actions"><a class="hero-primary" href="#agenda">Bekijk de dorpsagenda <span>↓</span></a><a class="hero-secondary" href="/lid-worden/">Doe mee in het dorp <span>→</span></a></div></div><div class="hero-place"><span>SFEERBEELD</span><strong id="hero-place-name">{heroSlides[0].name}</strong><div class="hero-slide-controls"><button id="hero-previous" type="button" aria-label="Vorig sfeerbeeld">←</button><span id="hero-slide-count">1 / {heroSlides.length}</span><button id="hero-next" type="button" aria-label="Volgend sfeerbeeld">→</button><button id="hero-pause" type="button" aria-label="Automatisch wisselen pauzeren">Pauze</button></div></div><div class="hero-today"><span>Vandaag in Sint Jut</span><strong>Za 12 september</strong><a href="#agenda">Bekijk wat er speelt →</a></div></section>
<section class="quick" aria-label="Snel naar"><a href="#agenda"><span class="icon">▦</span><div><strong>Wat is er te doen?</strong><small>Bekijk de dorpsagenda</small></div><span>→</span></a><a href="#ruimtes"><span class="icon">⌂</span><div><strong>Een ruimte nodig?</strong><small>Bekijk de beschikbaarheid</small></div><span>→</span></a><a href="#verenigingen"><span class="icon">◎</span><div><strong>Doe mee in het dorp</strong><small>Verenigingen & initiatieven</small></div><span>→</span></a></section>
<div class="topic-nav" aria-label="Dorpsonderwerpen"><a href="/lid-worden/">Word lid</a><a href="#dorpsgids">Dorpsgids</a><a href="/verenigingen/">Organisatoren</a><a href="/dodenherdenking/">Dodenherdenking</a><a href="/dorpsfilms/">Dorpsfilms</a><a href="/woningbouw/">Woningbouw</a><a href="#facebook">Facebooknieuws</a><a href="#vragen">Praktische vragen</a></div><Agenda/>
<section id="dorpsgids" class="village-guide">
  <div class="guide-heading"><div><div class="eyebrow">VIND JE PLEK IN DE BUURT</div><h2>De mensen en plekken<br/>die Sint Jut maken.</h2></div><div class="guide-seal" aria-hidden="true"><span>SINT JUT</span><strong>♥</strong><span>SAMEN</span></div></div>
  <div class="guide-grid">
    <article class="guide-panel guide-celebrate"><div class="guide-symbol" aria-hidden="true">✦</div><span class="guide-kicker">FEESTMAKERS</span><h3>Vrijwilligers die<br/>het dorp laten bruisen.</h3><p>Lokale commissies en verenigingen organiseren festiviteiten en bijzondere dorpsmomenten.</p><div class="guide-links"><a href="/verenigingen/#abe-sjipkop"><span>Abe Sjipkop</span><b>Promotieteam & festiviteiten</b><i>→</i></a><a href="/verenigingen/#oranjevereniging"><span>Oranjevereniging</span><b>Feesten & activiteiten</b><i>→</i></a><a href="/verenigingen/#it-middelpunt"><span>It Middelpunt</span><b>Activiteitencommissie</b><i>→</i></a></div></article>
    <article class="guide-panel guide-local"><div class="guide-symbol" aria-hidden="true">⌂</div><span class="guide-kicker">LOKALE VOORZIENINGEN</span><h3>Gewoon goed.<br/>Lekker dichtbij.</h3><p>Voor boodschappen, een hapje eten en persoonlijke verzorging hoef je Sint Jut niet uit.</p><div class="guide-links"><a href="https://www.spar.nl/winkels/spar-van-zwol-833/"><span>SPAR van Zwol</span><b>Boodschappen · Sint Jut</b><i>→</i></a><a href="https://www.uitagenda.nl/locaties/eetcafe-rusan"><span>Eetcafé Rus'an</span><b>Eten & ontmoeten · Sint Jut</b><i>→</i></a><a href="https://www.lydiatenboom.nl/"><span>Lydia's Haarstyling</span><b>Kapper · Sint Jut</b><i>→</i></a></div></article>
    <article class="guide-panel guide-sport"><div class="guide-symbol" aria-hidden="true">●</div><span class="guide-kicker">SPORT & SPEL</span><h3>Samen trainen.<br/>Samen aan tafel.</h3><p>Van voetbal en tennis tot biljarten en klaverjassen: er is altijd een club om bij aan te sluiten.</p><div class="guide-links"><a href="https://www.vvdwp.nl/"><span>Voetbalvereniging DWP</span><b>Voetbal · Sint Jut</b><i>→</i></a><a href="https://www.tvsintjohannesga.nl/"><span>Tennisvereniging Sintjohannesga e.o.</span><b>Tennis · Sint Jut</b><i>→</i></a><a href="/verenigingen/#otkook"><span>OTKook</span><b>Biljart · Sint Jut</b><i>→</i></a><a href="/verenigingen/#klaverjas-dwp"><span>Klaverjasvereniging DWP</span><b>Klaverjassen · Sint Jut</b><i>→</i></a></div></article>
  </div>
  <div class="guide-ticker" aria-hidden="true"><span>SINT JUT</span><i>✦</i><span>ÉÉN DORPSGEMEENSCHAP</span><i>✦</i><span>ALTIJD DICHTBIJ</span></div>
</section>

<section id="verenigingen"><div class="join-banner"><div><div class="eyebrow">DOE MEE IN SINT JUT</div><h2>Word lid van onze verenigingen.</h2><p>Dorpsbelang, de ijsclub en de Oranjevereniging: meld je aan bij één of meer verenigingen via het gezamenlijke formulier.</p></div><a class="action" href="/lid-worden/">Bekijk hoe je lid wordt →</a></div><div class="section-head"><div><div class="eyebrow">SAMEN MAKEN WE HET DORP</div><h2>Er is een plek voor iedereen.</h2></div></div><div class="community"><article><span class="category-number">01 / SPORT</span><h3>Kom in beweging</h3><p>Voetbal bij DWP, tennis bij TV Sintjohannesga of aansluiten bij een andere club.</p><details><summary>Bekijk de sportclubs</summary><p>Ga naar <a href="https://www.vvdwp.nl/">Voetbalvereniging DWP</a> of <a href="https://www.tvsintjohannesga.nl/">Tennisvereniging Sintjohannesga e.o.</a> voor het actuele aanbod en lidmaatschap.</p></details></article><article><span class="category-number">02 / INITIATIEVEN</span><h3>Een goed idee begint hier</h3><p>Van een groenere straat tot een helpende hand. Geef jouw idee een plek in het dorp.</p><details><summary>Ontdek de mogelijkheden</summary><p>Ontdek het bestaande initiatief <a href="https://www.sintjut.frl/biodiversiteit/">Biodiversiteit</a>. Nieuwe initiatiefpagina’s vermelden het doel, wie er meedoet en welke hulp nodig is.</p></details></article><article><span class="category-number">03 / VRIJWILLIGERS</span><h3>Een beetje tijd, veel verschil</h3><p>Help bij een feest, dorpsactiviteit of vereniging. Jouw inzet maakt het programma mogelijk.</p><details><summary>Zo kun je meedoen</summary><p>Maak kennis met de vrijwilligersorganisaties <a href="/verenigingen/#abe-sjipkop">Abe Sjipkop</a> en de <a href="/verenigingen/#oranjevereniging">Oranjevereniging</a>.</p></details></article></div></section>
<section class="feature-links"><a href="/verenigingen/#abe-sjipkop"><img class="feature-image" src="/media/abe-sjipkop-mudrun.jpg" alt="Deelnemers aan de Abe Sjipkop Mudrun" loading="lazy"/><span class="eyebrow">VRIJWILLIGERSORGANISATIE</span><h3>Abe Sjipkop</h3><p>Organiseert festiviteiten en bijzondere dorpsmomenten, van Mudrun tot straatfestival.</p><span>Bekijk de organisatie →</span></a><a href="/verenigingen/#oranjevereniging"><img class="feature-image feature-logo" src="/media/oranjevereniging.jpg" alt="Logo Oranjevereniging Sintjohannesga" loading="lazy"/><span class="eyebrow">VRIJWILLIGERSORGANISATIE</span><h3>Oranjevereniging Sintjohannesga e.o.</h3><p>Vrijwilligers die feesten en activiteiten voor Sint Jut organiseren.</p><span>Ontdek de organisatie →</span></a><a href="/dodenherdenking/"><img class="feature-image" src="/media/hero-sintjohannesga.webp" alt="Sfeerbeeld van het landschap rond Sint Jut" loading="lazy"/><span class="eyebrow">4 MEI</span><h3>Samen herdenken</h3><p>Een vaste plek voor Dodenherdenking en de verhalen uit ons dorp.</p><span>Over Dodenherdenking →</span></a></section><Facebook/><section id="historie" class="history"><div class="history-visual"><div id="slide-image"></div><div class="archive-empty"><span>HET FOTOALBUM VAN ONS DORP</span><strong>Bewaar het verleden.<br/>Deel de verhalen.</strong><p>Hier verschijnen de historische foto's<br/>uit het dorpsarchief.</p></div><span class="photo-label" id="photo-label">Archiefselectie wordt nog aangesloten</span></div><div class="history-copy"><div class="eyebrow">TOEN & NU</div><h2>Een dorp vol<br/>herinneringen.</h2><p>Herken je die straat? En wie staan er op die foto? Iedere week een nieuwe greep uit ons gezamenlijke verleden.</p><p id="slide-caption" class="note">Bekijk alvast <a href="https://www.sintjut.frl/historie/">Historie</a> en de <a href="https://www.sintjut.frl/dorpsfilms/">dorpsfilms</a> op de bestaande website. De slideshow is voorbereid voor een wekelijkse fotoselectie uit ownCloud. Er zijn nog geen archieffoto's aangesloten.</p><p><a class="action" href="/dorpsfilms/">Bekijk de historische dorpsfilms ▶</a></p><div class="slide-controls"><button id="previous" aria-label="Vorige foto" disabled>←</button><span id="slide-count">Geen foto's</span><button id="next" aria-label="Volgende foto" disabled>→</button><button id="pause" disabled>Pauzeren</button></div></div></section>
<section class="join-banner"><div><div class="eyebrow">WONEN IN SINT JUT</div><h2>Hoe staat het met de woningbouw?</h2><p>Een eigen plek voor plannen, officiële bronnen en vragen over wonen in Sint Jut.</p></div><a class="action" href="/woningbouw/">Naar het woningbouwdossier →</a></section><section id="vragen" class="faq"><div><div class="eyebrow">SNEL EEN ANTWOORD</div><h2>Waar kan ik terecht?</h2><p>De meest gezochte informatie<br/>op één plek.</p><label class="search-label" for="search">Zoek in de vragen</label><input type="search" id="search" placeholder="Bijvoorbeeld: ruimte of activiteit"/></div><div id="questions"><details><summary>Hoe vraag ik een dorpsruimte aan?</summary><p>Kies hierboven een datum en dagdeel. Je ziet direct de actuele beschikbaarheid en stuurt daarna je aanvraag naar de beheerders. Na goedkeuring via Telegram wordt de reservering definitief.</p></details><details><summary>Hoe meld ik een activiteit aan?</summary><p>Vul hierboven de titel, datum, tijd, ruimte en contactgegevens in. De beheerders controleren de aanvraag vóór publicatie.</p></details><details><summary>Hoe komt mijn vereniging op de website?</summary><p>Elke vereniging kan een profiel krijgen met een korte introductie, vaste activiteiten en contactgegevens. De definitieve contactroute wordt samen met de dorpsredactie ingericht.</p></details><details><summary>Kan ik historische foto's bijdragen?</summary><p>Ja, in het voorstel beheert de archiefgroep een centrale ownCloud-map. Voeg plaats, jaartal, fotograaf en toestemming voor publicatie toe. Uploadtoegang en contactpersoon moeten nog worden afgesproken.</p></details><details><summary>Waar vind ik gemeentelijke informatie?</summary><p>Voor gemeentelijke zaken ga je naar <a href="https://www.defryskemarren.nl/">de website van De Fryske Marren</a>.</p></details><p id="no-questions" hidden>Geen passende vraag gevonden. Probeer ‘activiteit’, ‘vereniging’, ‘foto’ of ‘ruimte’.</p></div></section></main>
<footer><Logo /><p>Sint Jut · één dorpsgemeenschap</p><span>Samen dichtbij.</span></footer>

<script>
const q=(s:string)=>document.querySelector(s) as HTMLElement;
q('#search').addEventListener('input',e=>{let n=0;const term=(e.target as HTMLInputElement).value.toLocaleLowerCase();document.querySelectorAll<HTMLDetailsElement>('#questions details').forEach(d=>{d.hidden=!d.textContent?.toLocaleLowerCase().includes(term);if(!d.hidden)n++;});q('#no-questions').hidden=n>0});
const hero=q('#hero');const heroSlides=JSON.parse(hero.dataset.slides||'[]');let heroIndex=0;let heroPaused=matchMedia('(prefers-reduced-motion: reduce)').matches;const heroImage=q('#hero-image') as HTMLImageElement;const showHero=(next:number)=>{heroIndex=(next+heroSlides.length)%heroSlides.length;const slide=heroSlides[heroIndex];const preload=new Image();preload.onload=()=>{heroImage.classList.add('is-changing');setTimeout(()=>{heroImage.src=slide.src;heroImage.alt=slide.alt;q('#hero-place-name').textContent=slide.name;q('#hero-slide-count').textContent=`${heroIndex+1} / ${heroSlides.length}`;heroImage.classList.remove('is-changing');const upcoming=heroSlides[(heroIndex+1)%heroSlides.length];new Image().src=upcoming.src;},180)};preload.src=slide.src;};q('#hero-previous').onclick=()=>showHero(heroIndex-1);q('#hero-next').onclick=()=>showHero(heroIndex+1);q('#hero-pause').textContent=heroPaused?'Afspelen':'Pauze';q('#hero-pause').onclick=()=>{heroPaused=!heroPaused;q('#hero-pause').textContent=heroPaused?'Afspelen':'Pauze';q('#hero-pause').setAttribute('aria-label',heroPaused?'Automatisch wisselen hervatten':'Automatisch wisselen pauzeren')};setInterval(()=>{if(!heroPaused&&!document.hidden)showHero(heroIndex+1)},7000);if(heroSlides[1])new Image().src=heroSlides[1].src;
// Only publish approved, public image URLs in this manifest; never ownCloud credentials.
fetch('/archive.json').then(r=>{if(!r.ok)throw Error();return r.json()}).then(data=>{const photos=data.photos.filter((p:any)=>p.approved&&p.url&&p.caption);if(!photos.length)return;const today=new Intl.DateTimeFormat('sv-SE',{timeZone:'Europe/Amsterdam'}).format(new Date());const day=new Date(today+'T00:00:00Z');const monday=day.getTime()-((day.getUTCDay()+6)%7)*86400000;const week=Math.floor(monday/604800000);const start=((week%photos.length)+photos.length)%photos.length;const chosen=Array.from({length:Math.min(5,photos.length)},(_,i)=>photos[(start+i)%photos.length]);let index=0;let paused=matchMedia('(prefers-reduced-motion: reduce)').matches;const show=()=>{const p=chosen[index];const img=new Image();img.alt=p.caption;img.onload=()=>{q('#slide-image').replaceChildren(img);q('.archive-empty').hidden=true;q('#photo-label').textContent=p.credit||'Dorpsarchief';q('#slide-caption').textContent=p.caption;q('#slide-count').textContent=`${index+1} / ${chosen.length}`};img.onerror=()=>{q('#slide-caption').textContent='Deze archieffoto is tijdelijk niet beschikbaar.'};img.src=p.url;};['#previous','#next','#pause'].forEach(id=>(q(id) as HTMLButtonElement).disabled=false);q('#previous').onclick=()=>{index=(index-1+chosen.length)%chosen.length;show()};q('#next').onclick=()=>{index=(index+1)%chosen.length;show()};q('#pause').textContent=paused?'Afspelen':'Pauzeren';q('#pause').onclick=()=>{paused=!paused;q('#pause').textContent=paused?'Afspelen':'Pauzeren'};setInterval(()=>{if(!paused&&!document.hidden){index=(index+1)%chosen.length;show()}},7000);show();}).catch(()=>{});
</script>
</body></html>
