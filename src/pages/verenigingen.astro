---
import Content from '../layouts/Content.astro';
const organisations = [
  { id:'oranjevereniging', category:'VRIJWILLIGERSORGANISATIE · FESTIVITEITEN', name:'Oranjevereniging Sintjohannesga e.o.', description:'Vrijwilligers die feesten en activiteiten voor Sint Jut organiseren.', image:'/media/oranjevereniging.jpg', alt:'Logo Oranjevereniging Sintjohannesga', fit:'contain', links:[['Bekijk het programma →','https://ovsintjut.nl/','primary'],['Word lid →','/lid-worden/','']] },
  { id:'abe-sjipkop', category:'VRIJWILLIGERSORGANISATIE · FESTIVITEITEN', name:'Abe Sjipkop', description:'Vrijwilligersorganisatie achter festiviteiten en bijzondere dorpsmomenten, waaronder de Mudrun en het straatfestival.', image:'/media/abe-sjipkop-mudrun.jpg', alt:'Deelnemers aan de Abe Sjipkop Bevrijdings Mudrun', credit:'Foto: Creagrafisch · Marcel de Graaf', links:[['Dodenherdenking →','/dodenherdenking/','primary'],['Lees het portret →','https://rtvspannenburg.nl/2025/09/12/sinds-1990-een-begrip-in-het-dorp-abe-sjipkop-viert-jubileum/','']] },
  { id:'it-middelpunt', category:'ACTIVITEITENCOMMISSIE · FEESTMAKERS', name:'It Middelpunt', description:'Activiteitencommissie die ontmoeting, gezelligheid en activiteiten in Sint Jut organiseert.', image:'https://www.sintjut.frl/wp-content/uploads/2025/10/It-Middelpunt.jpg', alt:'Logo activiteitencommissie It Middelpunt', fit:'contain', links:[] },
  { id:'dwp', category:'SPORTVERENIGING · VOETBAL', name:'Voetbalvereniging DWP', description:'Voetbal voor jeugd en senioren op Sportpark De Grie in Sint Jut.', image:'https://www.sintjut.frl/wp-content/uploads/2025/03/Voetbalvereniging-DWP.png', alt:'Logo Voetbalvereniging DWP', fit:'contain', links:[['Naar vvdwp.nl →','https://www.vvdwp.nl/','primary']] },
  { id:'tennis', category:'SPORTVERENIGING · TENNIS', name:'Tennisvereniging Sintjohannesga e.o.', description:'Tennis op twee gravelbanen aan de Streek in Sint Jut.', image:'/media/tennisvereniging.png', alt:'Logo Tennisvereniging Sintjohannesga en omgeving', fit:'contain', links:[['Bekijk de tennisvereniging →','https://www.tvsintjohannesga.nl/','primary']] },
  { id:'otkook', category:'SPORTVERENIGING · BILJART', name:'OTKook', description:'Biljartvereniging “Op Tiid Kriitsje” in Sint Jut. Bekijk via Facebook het laatste nieuws en de activiteiten.', image:'https://www.sintjut.frl/wp-content/uploads/2025/10/OTK.jpg', alt:'Logo biljartvereniging OTKook', fit:'contain', links:[['Bekijk OTKook op Facebook →','https://www.facebook.com/bvOTK','primary']] },
  { id:'klaverjas-dwp', category:'SPELVERENIGING · KLAVERJASSEN', name:'Klaverjasvereniging DWP', description:'De lokale vereniging voor samen klaverjassen in Sint Jut.', image:'https://www.sintjut.frl/wp-content/uploads/2025/10/2500-klaverjas-DWP.jpg.png', alt:'Logo Klaverjasvereniging DWP', fit:'contain', links:[] },
  { id:'dorpsbelang', category:'BELANGENVERENIGING', name:'Dorpsbelang', description:'Betrokken bij Sint Jut en de onderwerpen die hier leven. Bekijk de contactinformatie of steun de vereniging als lid.', image:'/media/dorpsbelang-logo.png', alt:'Logo Dorpengemeenschap Sintjohannesga en omgeving', fit:'contain', links:[['Word lid →','/lid-worden/','primary'],['Contact met Dorpsbelang →','https://www.sintjut.frl/contact/','']] },
  { id:'ijsclub', category:'SPORTVERENIGING · SCHAATSEN', name:'IJsclub Eensgezindheid', description:'De lokale ijsclub voor schaatsplezier wanneer het winterweer meewerkt.', image:'https://www.sintjut.frl/wp-content/uploads/2025/10/IJsclub-Eensgezindheid-e1761683277534.png', alt:'Logo IJsclub Eensgezindheid', fit:'contain', links:[['Word lid van de ijsclub →','/lid-worden/','primary']] }
];
---
<Content title="Samen maken we Sint Jut." intro="Word lid, help mee of ontdek welke vrijwilligers de festiviteiten in onze dorpsgemeenschap organiseren." eyebrow="VERENIGINGEN & VRIJWILLIGERS" heroImage="/media/hero-rotsterhaule.webp" heroAlt="Sfeerbeeld van boerderijen, water en weilanden rond Sint Jut">
<section class="join-banner"><div><h2>Jouw lidmaatschap telt.</h2><p>Via het bestaande formulier kun je je aanmelden bij Dorpsbelang, de ijsclub en de Oranjevereniging.</p></div><a class="action" href="/lid-worden/">Kies je vereniging →</a></section>
<section class="community directory organisation-directory">{organisations.map(organisation => <article id={organisation.id}>
  <div class:list={['organisation-media', organisation.fit === 'contain' && 'logo-media']}><img src={organisation.image} alt={organisation.alt} loading="lazy" width="760" height="430"/>{organisation.credit && <small>{organisation.credit}</small>}</div>
  <div class="organisation-copy"><span class="category-number">{organisation.category}</span><h2>{organisation.name}</h2><p>{organisation.description}</p><div class="actions">{organisation.links.map(([label,url,kind]) => <a class={kind === 'primary' ? 'action' : ''} href={url}>{label}</a>)}</div></div>
</article>)}</section>
</Content>
<script>
document.querySelectorAll<HTMLImageElement>('.organisation-media img').forEach(image=>image.addEventListener('error',()=>{image.src='/favicon.svg';image.alt='Sint Jut';},{once:true}));
</script>
