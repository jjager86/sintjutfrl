---
import Content from '../layouts/Content.astro';
---
<Content title="Evenementenkalender" intro="Bekijk per maand wat er in Sint Jut te doen is en zet de dorpsagenda in je eigen kalender." eyebrow="WAT IS ER TE DOEN?" heroImage="/media/hero-rohel.webp" heroAlt="Sfeerbeeld van het landschap rond Sint Jut">
  <section class="month-calendar" aria-labelledby="calendar-title">
    <div class="calendar-heading"><div><span class="eyebrow">DORPSAGENDA</span><h2 id="calendar-title">Alles in één kalender.</h2><p>Activiteiten van de gezamenlijke dorpskern, overzichtelijk per maand.</p></div><div class="calendar-heading-actions"><button id="request-event" type="button">Evenement aanmelden</button><a class="calendar-subscribe" href="/api/v1/calendar.ics">＋ Zet in mijn kalender</a></div></div>
    <div class="calendar-toolbar"><button id="calendar-previous" type="button" aria-label="Vorige maand">←</button><strong id="calendar-month" aria-live="polite"></strong><button id="calendar-next" type="button" aria-label="Volgende maand">→</button><button id="calendar-today" type="button">Vandaag</button></div>
    <p id="calendar-status" class="note" role="status">Kalender laden…</p>
    <div id="calendar-grid" class="calendar-grid" aria-live="polite"></div>
  </section>
  <section class="join-banner"><div><span class="eyebrow">ZELF IETS ORGANISEREN?</span><h2>Voeg jouw activiteit toe.</h2><p>Vraag een dorpsruimte aan of neem contact op met de beheerder om een activiteit op de agenda te zetten.</p></div><a class="action" href="/#ruimtes">Bekijk de dorpsruimtes →</a></section>

  <dialog id="event-request-dialog" class="reservation-dialog"><button class="close" type="button" aria-label="Sluiten">×</button><div class="eyebrow">EVENEMENT AANMELDEN</div><h2>Vraag plaatsing aan.</h2><p>Een beheerder controleert de gegevens voordat het evenement openbaar in de kalender verschijnt.</p><form id="event-request-form"><div class="form-grid"><label class="wide">Naam evenement<input name="title" maxlength="180" required/></label><label>Begint<input name="starts_at" type="datetime-local" required/></label><label>Eindigt<input name="ends_at" type="datetime-local" required/></label><label class="wide">Locatie<input name="location" maxlength="255" required placeholder="Bijvoorbeeld: sportveld of dorpshuis"/></label><label class="wide">Openbare omschrijving<textarea name="public_description" maxlength="2000" rows="4"></textarea></label><label>Naam organisator<input name="organizer_name" maxlength="160" autocomplete="name" required/></label><label>E-mailadres<input name="organizer_email" type="email" maxlength="254" autocomplete="email" required/></label><label class="wide">Telefoonnummer<input name="organizer_phone" type="tel" maxlength="40" autocomplete="tel"/></label></div><p class="privacy-note">Je contactgegevens zijn alleen voor de beheerders en verschijnen niet in de openbare kalender.</p><p id="event-request-result" role="status"></p><div class="dialog-actions"><button type="button" class="dialog-cancel">Annuleren</button><button type="submit" class="dialog-submit">Aanvraag versturen →</button></div></form></dialog>

  <script>
    const grid=document.querySelector('#calendar-grid') as HTMLElement,monthLabel=document.querySelector('#calendar-month') as HTMLElement,status=document.querySelector('#calendar-status') as HTMLElement;
    const monthNames=new Intl.DateTimeFormat('nl-NL',{month:'long',year:'numeric',timeZone:'Europe/Amsterdam'}),timeFormat=new Intl.DateTimeFormat('nl-NL',{hour:'2-digit',minute:'2-digit',timeZone:'Europe/Amsterdam'}),weekdays=['ma','di','wo','do','vr','za','zo'];
    let shown=new Date();shown=new Date(shown.getFullYear(),shown.getMonth(),1);
    const isoDay=(date:Date)=>`${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}-${String(date.getDate()).padStart(2,'0')}`;
    function visibleRange(){const first=new Date(shown),offset=(first.getDay()+6)%7,start=new Date(first);start.setDate(first.getDate()-offset);const end=new Date(start);end.setDate(start.getDate()+42);return{start,end};}
    async function loadCalendar(){
      const {start,end}=visibleRange();monthLabel.textContent=monthNames.format(shown);status.textContent='Activiteiten laden…';
      try{const response=await fetch(`/api/v1/agenda?from=${encodeURIComponent(start.toISOString())}&to=${encodeURIComponent(end.toISOString())}`,{cache:'no-store'}),data=await response.json();if(!response.ok)throw new Error(data.error||'Kalender laden mislukt.');render(data.events,start);status.textContent=data.events.length?`${data.events.length} ${data.events.length===1?'activiteit':'activiteiten'} in dit kalenderoverzicht.`:'Er staan voor deze maand nog geen activiteiten in de agenda.';}catch(error){grid.replaceChildren();status.textContent=error instanceof Error?error.message:'De evenementenkalender is tijdelijk niet bereikbaar.';}
    }
    function render(events:any[],start:Date){
      grid.replaceChildren();for(const weekday of weekdays){const label=document.createElement('div');label.className='calendar-weekday';label.textContent=weekday;grid.append(label);}
      for(let index=0;index<42;index++){const date=new Date(start);date.setDate(start.getDate()+index);const day=document.createElement('article');day.className='calendar-day';if(date.getMonth()!==shown.getMonth())day.classList.add('outside');if(isoDay(date)===isoDay(new Date()))day.classList.add('today');const dayEvents=events.filter(item=>isoDay(new Date(item.starts_at))===isoDay(date));if(dayEvents.length)day.classList.add('has-events');const heading=document.createElement('div');heading.className='calendar-day-heading';const mobileDate=document.createElement('span');mobileDate.textContent=date.toLocaleDateString('nl-NL',{weekday:'long',day:'numeric',month:'long'});const number=document.createElement('b');number.textContent=String(date.getDate());heading.append(mobileDate,number);day.append(heading);for(const item of dayEvents){const event=document.createElement('div');event.className='calendar-item';const time=document.createElement('time');time.dateTime=item.starts_at;time.textContent=timeFormat.format(new Date(item.starts_at));const title=document.createElement('strong');title.textContent=item.title;const place=document.createElement('small');place.textContent=item.location||item.resource_location||item.resource_name;event.append(time,title,place);day.append(event);}grid.append(day);}
    }
    document.querySelector('#calendar-previous')?.addEventListener('click',()=>{shown=new Date(shown.getFullYear(),shown.getMonth()-1,1);loadCalendar();});document.querySelector('#calendar-next')?.addEventListener('click',()=>{shown=new Date(shown.getFullYear(),shown.getMonth()+1,1);loadCalendar();});document.querySelector('#calendar-today')?.addEventListener('click',()=>{const now=new Date();shown=new Date(now.getFullYear(),now.getMonth(),1);loadCalendar();});
    const requestDialog=document.querySelector('#event-request-dialog') as HTMLDialogElement,requestForm=document.querySelector('#event-request-form') as HTMLFormElement,requestResult=document.querySelector('#event-request-result') as HTMLElement;document.querySelector('#request-event')?.addEventListener('click',()=>requestDialog.showModal());requestDialog.querySelector('.close')?.addEventListener('click',()=>requestDialog.close());requestDialog.querySelector('.dialog-cancel')?.addEventListener('click',()=>requestDialog.close());requestForm.addEventListener('submit',async event=>{event.preventDefault();const submit=requestForm.querySelector<HTMLButtonElement>('.dialog-submit')!;submit.disabled=true;requestResult.textContent='Aanvraag versturen…';const data=Object.fromEntries(new FormData(requestForm));try{const response=await fetch('/api/v1/event-requests',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({...data,starts_at:new Date(String(data.starts_at)).toISOString(),ends_at:new Date(String(data.ends_at)).toISOString()})}),result=await response.json();if(!response.ok)throw new Error(result.error||'Aanvraag versturen mislukt.');requestForm.reset();requestResult.textContent=`Bedankt. Je aanvraag ${result.reference} is naar de beheerder gestuurd.`;}catch(error){requestResult.textContent=error instanceof Error?error.message:'Aanvraag versturen mislukt.';}finally{submit.disabled=false;}});loadCalendar();
  </script>
</Content>
