---
const periods = [
  { value: 'morning', label: 'Ochtend', start: '09:00', end: '12:00' },
  { value: 'afternoon', label: 'Middag', start: '13:00', end: '17:00' },
  { value: 'evening', label: 'Avond', start: '19:00', end: '23:00' }
];
---
<section id="agenda" class="agenda live-agenda">
  <div class="section-head">
    <div><div class="eyebrow">ER IS ALTIJD IETS DICHTBIJ</div><h2>Op de dorpsagenda</h2></div>
    <div class="agenda-controls"><button id="agenda-previous" aria-label="Eerdere activiteiten">←</button><button id="agenda-next" aria-label="Latere activiteiten">→</button></div>
  </div>
  <p class="note" id="agenda-range">Activiteiten laden…</p>
  <div class="events" id="agenda-events" aria-live="polite"><div class="agenda-loading">Agenda wordt opgehaald…</div></div>
  <p id="agenda-empty" hidden>Er staan in deze periode nog geen openbare activiteiten.</p>
</section>

<section id="ruimtes" class="rooms live-rooms">
  <div class="room-intro">
    <div class="eyebrow">PLEK VOOR JOUW PLANNEN</div>
    <h2>Bekijk wanneer<br/>er ruimte is.</h2>
    <p>Kies een datum en dagdeel. Een beheerder beoordeelt je aanvraag; na goedkeuring verschijnt de reservering definitief in de agenda.</p>
    <span class="demo">Live beschikbaarheid · aanvraag zonder account</span>
  </div>
  <div class="room-table">
    <div class="room-controls">
      <label>Datum<input id="room-date" type="date"/></label>
      <fieldset class="period-picker"><legend>Dagdeel</legend><div role="group" aria-label="Kies een dagdeel">{periods.map((period,index) => <button type="button" class:list={['period-button',index===0&&'is-selected']} data-value={period.value} data-start={period.start} data-end={period.end} aria-pressed={index===0?'true':'false'}>{period.label}</button>)}</div></fieldset>
    </div>
    <div id="room-results" aria-live="polite"><p>Beschikbaarheid laden…</p></div>
    <p class="room-note">Een aanvraag is pas definitief nadat een beheerder deze heeft goedgekeurd.</p>
  </div>
</section>

<dialog id="reservation-dialog" class="reservation-dialog">
  <button class="close" type="button" aria-label="Sluiten">×</button>
  <div class="eyebrow">RESERVERING AANVRAGEN</div>
  <h2 id="reservation-title">Een plek voor je plannen</h2>
  <p id="reservation-summary"></p>
  <form id="reservation-form">
    <input type="hidden" name="resource_id"/>
    <input type="hidden" name="starts_at"/>
    <input type="hidden" name="ends_at"/>
    <div class="form-grid">
      <label class="wide">Activiteit of bijeenkomst<input name="title" maxlength="180" required placeholder="Bijvoorbeeld: jubileumavond"/></label>
      <label>Naam contactpersoon<input name="organizer_name" maxlength="160" autocomplete="name" required/></label>
      <label>E-mailadres<input name="organizer_email" type="email" maxlength="254" autocomplete="email" required/></label>
      <label>Telefoonnummer<input name="organizer_phone" type="tel" maxlength="40" autocomplete="tel"/></label>
      <label>Aantal personen<input name="attendee_count" type="number" min="1" max="2000" inputmode="numeric"/></label>
      <label class="wide">Toelichting<textarea name="description" maxlength="4000" rows="4" placeholder="Vertel de beheerder wat je wilt organiseren en wat je nodig hebt."></textarea></label>
      <label class="wide checkbox"><input name="publish_details" type="checkbox"/> Toon na goedkeuring een openbare omschrijving in de agenda</label>
      <label class="wide public-description" hidden>Openbare omschrijving<textarea name="public_description" maxlength="2000" rows="3" placeholder="Deze tekst mag iedereen op de website zien."></textarea></label>
    </div>
    <div id="turnstile-area" class="turnstile-area" hidden><div id="turnstile-widget"></div></div>
    <p class="privacy-note">Je contactgegevens zijn alleen zichtbaar voor de beheerders en worden niet in de openbare agenda getoond.</p>
    <div class="dialog-actions"><button type="button" class="dialog-cancel">Annuleren</button><button type="submit" class="dialog-submit">Aanvraag versturen →</button></div>
    <p id="reservation-result" role="status"></p>
  </form>
</dialog>

<script>
  const $ = (selector: string) => document.querySelector(selector) as HTMLElement;
  const api = '';
  const roomDate = $('#room-date') as HTMLInputElement;
  const periodButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.period-button'));
  const dialog = $('#reservation-dialog') as HTMLDialogElement;
  const form = $('#reservation-form') as HTMLFormElement;
  let agendaOffset = 0;
  let submitted = false;
  let turnstileEnabled = false;
  let turnstileWidget: string | number | null = null;
  const knownEventLogos = [
    [/klaverjas/i, 'https://www.sintjut.frl/wp-content/uploads/2025/10/2500-klaverjas-DWP.jpg.png'],
    [/\bdwp\b|voetbal/i, 'https://www.sintjut.frl/wp-content/uploads/2025/03/Voetbalvereniging-DWP.png'],
    [/tennis/i, '/media/tennisvereniging.png'],
    [/oranjevereniging/i, '/media/oranjevereniging.jpg'],
    [/abe sjipkop|mudrun/i, '/media/abe-sjipkop-mudrun.jpg'],
    [/it middelpunt/i, 'https://www.sintjut.frl/wp-content/uploads/2025/10/It-Middelpunt.jpg'],
    [/otkook|op tiid kriitsje|biljart/i, 'https://www.sintjut.frl/wp-content/uploads/2025/10/OTK.jpg'],
    [/ijsclub|schaats/i, 'https://www.sintjut.frl/wp-content/uploads/2025/10/IJsclub-Eensgezindheid-e1761683277534.png']
  ] as const;

  function safeLogo(value: unknown) {
    if (typeof value !== 'string') return '';
    if (value.startsWith('/') && !value.startsWith('//')) return value;
    try { const url = new URL(value); return url.protocol === 'https:' && !url.username && !url.password ? url.href : ''; } catch { return ''; }
  }

  function eventLogo(event: any) {
    const supplied = safeLogo(event.logo_url) || safeLogo(event.resource_logo_url);
    if (supplied) return supplied;
    const searchable = `${event.title || ''} ${event.public_description || ''}`;
    return knownEventLogos.find(([pattern]) => pattern.test(searchable))?.[1] || '/favicon.svg';
  }

  async function loadTurnstile() {
    if (turnstileWidget !== null) { (window as any).turnstile?.reset(turnstileWidget); return; }
    const response = await fetch(`${api}/api/v1/config`); const { turnstile } = await response.json();
    turnstileEnabled = Boolean(turnstile.enabled);
    if (!turnstileEnabled) return;
    if (!turnstile.siteKey) throw new Error('Botbescherming is nog niet volledig geconfigureerd.');
    await new Promise<void>((resolve, reject) => {
      if ((window as any).turnstile) return resolve();
      const script = document.createElement('script'); script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit'; script.async = true; script.defer = true; script.onload = () => resolve(); script.onerror = () => reject(new Error('Botbescherming kon niet worden geladen.')); document.head.append(script);
    });
    $('#turnstile-area').hidden = false;
    turnstileWidget = (window as any).turnstile.render('#turnstile-widget', { sitekey: turnstile.siteKey, theme: 'light', language: 'nl', action: 'reserve' });
  }

  const localDate = (date: Date) => new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Amsterdam' }).format(date);
  roomDate.value = localDate(new Date());
  roomDate.min = roomDate.value;

  function selectedTimes() {
    const option = periodButtons.find(button => button.getAttribute('aria-pressed') === 'true') || periodButtons[0];
    const start = new Date(`${roomDate.value}T${option.dataset.start}:00`);
    const end = new Date(`${roomDate.value}T${option.dataset.end}:00`);
    return { start, end, label: option.textContent || '' };
  }

  async function loadAgenda() {
    const from = new Date(); from.setDate(from.getDate() + agendaOffset * 30); from.setHours(0, 0, 0, 0);
    const to = new Date(from); to.setDate(to.getDate() + 90);
    const container = $('#agenda-events'); container.innerHTML = '<div class="agenda-loading">Agenda wordt opgehaald…</div>';
    $('#agenda-range').textContent = `${new Intl.DateTimeFormat('nl-NL', { month: 'long', year: 'numeric' }).format(from)} – ${new Intl.DateTimeFormat('nl-NL', { month: 'long', year: 'numeric' }).format(to)}`;
    try {
      const response = await fetch(`${api}/api/v1/agenda?from=${encodeURIComponent(from.toISOString())}&to=${encodeURIComponent(to.toISOString())}`);
      if (!response.ok) throw new Error();
      const { events } = await response.json(); container.replaceChildren();
      ($('#agenda-empty') as HTMLElement).hidden = events.length > 0;
      for (const event of events) {
        const start = new Date(event.starts_at); const end = new Date(event.ends_at);
        const article = document.createElement('article'); article.className = 'event';
        const mark = document.createElement('div'); mark.className = 'event-mark';
        const markImage = document.createElement('img'); markImage.src = eventLogo(event); markImage.alt = event.logo_url ? `Logo van ${event.title}` : event.resource_logo_url ? `Logo van ${event.resource_name}` : 'Beeldmerk bij de activiteit'; markImage.width = 56; markImage.height = 56; markImage.addEventListener('error', () => { markImage.src = '/favicon.svg'; markImage.alt = 'Sint Jut'; }, { once: true }); mark.append(markImage);
        const date = document.createElement('div'); date.className = 'date';
        date.innerHTML = `<b>${start.toLocaleDateString('nl-NL', { day: '2-digit', timeZone: 'Europe/Amsterdam' })}</b><span>${start.toLocaleDateString('nl-NL', { month: 'short', timeZone: 'Europe/Amsterdam' }).replace('.', '').toUpperCase()}</span>`;
        const copy = document.createElement('div'); copy.className = 'event-copy';
        const tag = document.createElement('span'); tag.className = 'tag'; tag.textContent = event.resource_name;
        const title = document.createElement('h3'); title.textContent = event.title;
        const meta = document.createElement('p');
        const time = new Intl.DateTimeFormat('nl-NL', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Amsterdam' });
        meta.textContent = `${event.resource_location || event.resource_name} · ${time.format(start)} – ${time.format(end)}`;
        copy.append(tag, title, meta);
        if (event.public_description) { const details = document.createElement('details'); const summary = document.createElement('summary'); summary.textContent = 'Meer informatie'; const p = document.createElement('p'); p.textContent = event.public_description; details.append(summary, p); copy.append(details); }
        article.append(mark, date, copy); container.append(article);
      }
    } catch { container.innerHTML = '<p>De live agenda is tijdelijk niet bereikbaar. Probeer het later opnieuw.</p>'; }
  }

  async function loadAvailability() {
    const { start, end } = selectedTimes(); const container = $('#room-results'); container.innerHTML = '<p>Beschikbaarheid laden…</p>';
    try {
      const response = await fetch(`${api}/api/v1/availability?start=${encodeURIComponent(start.toISOString())}&end=${encodeURIComponent(end.toISOString())}`);
      if (!response.ok) throw new Error(); const { resources } = await response.json(); container.replaceChildren();
      if (!resources.length) { container.innerHTML = '<p>Er zijn nog geen ruimtes geconfigureerd.</p>'; return; }
      for (const resource of resources) {
        const row = document.createElement('div'); row.className = 'room-row';
        const name = document.createElement('strong'); name.textContent = resource.name;
        const status = document.createElement('span'); status.className = resource.available ? 'free' : 'busy'; status.textContent = resource.available ? 'Vrij' : 'Bezet';
        const button = document.createElement('button'); button.type = 'button'; button.textContent = resource.available ? 'Aanvragen' : 'Niet beschikbaar'; button.disabled = !resource.available;
        button.onclick = () => openReservation(resource);
        row.append(name, status, button); container.append(row);
      }
    } catch { container.innerHTML = '<p>Beschikbaarheid kan momenteel niet worden opgehaald.</p>'; }
  }

  function openReservation(resource: { id: string; name: string }) {
    const { start, end, label } = selectedTimes(); form.reset();
    (form.elements.namedItem('resource_id') as HTMLInputElement).value = resource.id;
    (form.elements.namedItem('starts_at') as HTMLInputElement).value = start.toISOString();
    (form.elements.namedItem('ends_at') as HTMLInputElement).value = end.toISOString();
    $('#reservation-summary').textContent = `${resource.name} · ${new Intl.DateTimeFormat('nl-NL', { dateStyle: 'full' }).format(start)} · ${label.toLowerCase()}`;
    $('#reservation-result').textContent = ''; $('.public-description').hidden = true; dialog.showModal();
    loadTurnstile().catch(error => { $('#reservation-result').textContent = error instanceof Error ? error.message : 'Botbescherming kon niet worden geladen.'; });
  }

  form.addEventListener('change', event => { if ((event.target as HTMLInputElement).name === 'publish_details') $('.public-description').hidden = !(event.target as HTMLInputElement).checked; });
  form.addEventListener('submit', async event => {
    event.preventDefault(); const submit = form.querySelector<HTMLButtonElement>('.dialog-submit')!; submit.disabled = true; submit.textContent = 'Versturen…';
    const data = Object.fromEntries(new FormData(form)); data.publish_details = (form.elements.namedItem('publish_details') as HTMLInputElement).checked;
    data.turnstile_token = turnstileWidget === null ? '' : (window as any).turnstile?.getResponse(turnstileWidget) || '';
    if (turnstileEnabled && !data.turnstile_token) { $('#reservation-result').textContent = 'Rond eerst de botcontrole af.'; submit.disabled = false; submit.textContent = 'Aanvraag versturen →'; return; }
    try {
      const response = await fetch(`${api}/api/v1/reservations`, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) });
      const result = await response.json(); if (!response.ok) throw new Error(result.error || 'Aanvraag mislukt.');
      submitted = true;
      form.innerHTML = `<div class="reservation-success"><span>✓</span><h3>Aanvraag ontvangen</h3><p>Referentie <strong>${result.reference}</strong></p><p>${result.message}</p><button type="button" class="dialog-done">Sluiten</button></div>`;
      form.querySelector('.dialog-done')?.addEventListener('click', () => dialog.close());
    } catch (error) { $('#reservation-result').textContent = error instanceof Error ? error.message : 'Aanvraag mislukt.'; if (turnstileWidget !== null) (window as any).turnstile?.reset(turnstileWidget); submit.disabled = false; submit.textContent = 'Aanvraag versturen →'; }
  });
  dialog.querySelector('.close')?.addEventListener('click', () => dialog.close());
  dialog.querySelector('.dialog-cancel')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => { if (submitted) window.location.reload(); });
  roomDate.addEventListener('change', loadAvailability);
  periodButtons.forEach(button => button.addEventListener('click', () => { periodButtons.forEach(item => { const selected=item===button; item.classList.toggle('is-selected',selected); item.setAttribute('aria-pressed',String(selected)); }); loadAvailability(); }));
  $('#agenda-previous').addEventListener('click', () => { agendaOffset--; loadAgenda(); });
  $('#agenda-next').addEventListener('click', () => { agendaOffset++; loadAgenda(); });
  loadAgenda(); loadAvailability();
</script>
